{
  "name": "kawsapacha-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "dev:garden-poc": "vite --config vite.garden-poc.config.ts --configLoader runner --host 127.0.0.1 --port 5176 --strictPort",
    "build:garden-poc": "tsc -b && vite build --config vite.garden-poc.config.ts --configLoader runner",
    "test:garden-poc": "playwright test --config playwright.garden-poc.config.ts",
    "test:unit": "playwright test --config playwright.unit.config.ts",
    "test:production": "playwright test --config playwright.production.config.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "phaser": "3.90.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.2",
    "vite": "^7.0.0"
  }
}
