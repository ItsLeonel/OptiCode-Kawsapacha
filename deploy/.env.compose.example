# Copiar al directorio raíz como .env, nunca subirlo al repositorio.
# Sin dominio: prueba local por HTTP; NO proporciona contexto seguro a getUserMedia.
SITE_ADDRESS=:80
PUBLIC_ORIGIN=http://localhost

# Para usar HTTPS automático: apuntar el DNS A/AAAA a la IP y configurar:
# SITE_ADDRESS=huerto.example.org
# PUBLIC_ORIGIN=https://huerto.example.org

# Generar un valor aleatorio largo; no reutilizar ejemplos ni subir credenciales.
JWT_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO_LARGO_DE_AL_MENOS_32_BYTES
JWT_EXPIRES_IN=7d
