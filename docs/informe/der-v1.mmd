    User {
        string id PK
        string email UK
        string role "USUARIO, ADMIN_MSP, ADMIN_TECNICO"
        boolean isActive
    }
    Community {
        string id PK
        string name
        string type
        string province
        string status "revisión MSP"
        string creatorId FK
    }
    CommunityMember {
        string id PK
        string communityId FK
        string userId FK
        string roleInCommunity "RESPONSABLE, CUIDADOR, PARTICIPANTE"
    }
    CommunityInvitation {
        string id PK
        string communityId FK
        string email
        string role
        string status
    }
    RealGarden {
        string id PK
        string kind "tierra, macetas, vertical, colgante"
        float areaM2
        string province
        string soilType
        string communityId FK
        string createdById FK
    }
    MedicinalCatalog {
        string id PK
        string name
        string latinName
        string family
        string regions
        string sourceLabel
    }
    CultivatedPlant {
        string id PK
        int plotIndex "0 a 5, único por huerto"
        string speciesId FK
        string realGardenId FK
        string lifecycleStatus
        string observedState "etapa observada"
    }
    GardenActivity {
        string id PK
        string gardenId FK
        string actorUserId FK
        string plantId FK
        string type
        string performedDate
        string reviewStatus
    }
    ActivityEvidence {
        string id PK
        string activityId FK
        string fileUrl
    }
    CareLog {
        string id PK
        string plantId FK
        string actionType
    }
    HarvestRecord {
        string id PK
        string realGardenId FK
        string communityId FK
        string quantity
    }
    CommunityResource {
        string id PK
        string communityId FK
        string category "herramienta, insumo, semilla"
        int quantity
        string status
    }
