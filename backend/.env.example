# ─── Kawsapacha Backend — Variables de entorno ───────────────────────────────
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el .env al repositorio.

# Base de datos SQLite (Prisma lo resuelve relativo a la carpeta prisma/)
DATABASE_URL="file:./kawsapacha.db"

# Puerto del servidor backend
PORT=3000

# Secret para firmar los JWT (cámbialo por una cadena larga y aleatoria)
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_en_produccion

# Tiempo de expiración de sesión (ej: 7d, 24h, 60m)
JWT_EXPIRES_IN=7d

# CORS: origen permitido del frontend Vite
CORS_ORIGIN=http://localhost:5173

